from: git://git.kernel.org/pub/scm/linux/kernel/git/stable/linux@v7.2
options:
  enable:
  - EFI
  - EFI_STUB
  - ACPI
  - PCI
  - NET
  - INET
  - IPV6
  - UNIX
  - NETDEVICES
  - BLK_DEV
  - BLK_DEV_INITRD
  - DEVTMPFS
  - DEVTMPFS_MOUNT
  - PROC_FS
  - SYSFS
  - TMPFS
  - PRINTK
  - TTY
  - SERIAL_8250
  - SERIAL_8250_CONSOLE
  - INPUT
  - INPUT_EVDEV
  - VT
  - VT_CONSOLE
  - SYSFB_SIMPLEFB
  - DRM_FBDEV_EMULATION
  - FRAMEBUFFER_CONSOLE
modules:
  builtin:
  - FAILOVER
  - NET_FAILOVER
  - VIRTIO
  - VIRTIO_PCI
  - VIRTIO_NET
  - VIRTIO_BLK
  - ACPI_BUTTON
  - DRM
  - DRM_SIMPLEDRM
actions:
# The x86 EFI stub and decompressor build without -march and inherit the
# compiler's default, which is x86-64-v3 on Ubuntu's amd64v3 toolchains and
# faults (#UD) on baseline CPUs such as qemu64.
- if: ${{ arch == 'amd64' }}
  actions:
  - addCompilerFlags: { flags: [-march=x86-64] }
